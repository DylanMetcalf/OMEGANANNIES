# --- Core ---
DATABASE_URL=postgres://omega:omega@localhost:5432/omega
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Signs document links, webhook handoffs and CSRF-sensitive tokens.
APP_SECRET=
# Two-step verification for all staff (default true outside demo). Keep on in production.
# REQUIRE_STAFF_MFA=true
# Bearer token for the hourly maintenance job GET /api/cron/daily
CRON_SECRET=
# true = isolated demo: no real payments, emails captured in outbox only, demo banner shown.
DEMO_MODE=true
# --- Storage (private documents). local = ./storage on server disk; supabase = Supabase Storage private bucket ---
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=omega-private
# --- Malware scanning (clamd). Empty = uploads marked "not scanned" ---
CLAMAV_HOST=
CLAMAV_PORT=3310
# --- Public website used by the nanny import ---
WEBSITE_URL=https://omeganannies.com
# --- Email (Resend). Empty = emails recorded in notification outbox only ---
RESEND_API_KEY=
EMAIL_FROM="Omega Nannies <bookings@omeganannies.com>"
# --- Payments (PayFast). Empty merchant id = payments disabled outside demo ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# --- Website enquiry handoff (shared HMAC secret with the Laravel site) ---
WEBSITE_WEBHOOK_SECRET=
# --- Calendly (optional): personal access token + webhook signing key ---
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
# --- AI assistant (optional). Empty = FAQ search only ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# --- SMS & WhatsApp (Twilio; optional). WhatsApp proactive messages need approved templates ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
# --- Email delivery confirmations (Resend webhook signing secret, whsec_…) ---
RESEND_WEBHOOK_SECRET=
# --- Two-way calendar sync (optional). Redirect URIs: $APP_URL/api/calendar/oauth/google|microsoft ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# 32+ random bytes; encrypts stored calendar tokens (defaults to a key derived from APP_SECRET)
CALENDAR_TOKEN_KEY=
