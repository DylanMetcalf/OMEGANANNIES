# --- Core ---
DATABASE_URL=postgres://omega:omega@localhost:5432/omega
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Signs document links, webhook handoffs and CSRF-sensitive tokens.
APP_SECRET=
# true = isolated demo: no real payments, emails captured in outbox only, demo banner shown.
DEMO_MODE=true
# --- Storage (private documents). local = ./storage on server disk; supabase = Supabase Storage private bucket ---
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=omega-private
# --- Email (Resend). Empty = emails recorded in notification outbox only ---
RESEND_API_KEY=
EMAIL_FROM="Omega Nannies <bookings@omeganannies.com>"
# --- Payments (PayFast). Empty merchant id = payments disabled outside demo ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# --- Website enquiry handoff (shared HMAC secret with the Laravel site) ---
WEBSITE_WEBHOOK_SECRET=
# --- Calendly (optional): personal access token + webhook signing key ---
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
# --- AI assistant (optional). Empty = FAQ search only ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
